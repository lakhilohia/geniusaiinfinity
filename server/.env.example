# ─────────────────────────────────────────────────────────────
# GeniusAI Infinity — backend configuration
# Copy this file to `.env` and fill in the values you have.
# Everything is optional: with no keys the app runs on demo data
# and email is in safe "dry-run" mode (nothing is actually sent).
# ─────────────────────────────────────────────────────────────

PORT=4000

# --- Your business identity (used in outreach emails) ---
BUSINESS_NAME=GeniusAI Infinity
BUSINESS_EMAIL=hello@geniusaiinfinity.com
BUSINESS_PHONE=+91-00000-00000
BUSINESS_WEBSITE=https://geniusaiinfinity.com
BUSINESS_ADDRESS=India

# --- Google Places API (optional, for REAL business data) ---
# Get a key at https://console.cloud.google.com  (Places API "Text Search").
# Without it, the app returns realistic demo leads instead.
GOOGLE_PLACES_API_KEY=

# --- Free LLM proxy (optional, to auto-write personalised emails) ---
# Based on github.com/tashfeenahmed/freellmapi style relays.
# If blank or unreachable, a built-in template is used instead.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- SMTP for really sending email (optional) ---
# LEAVE BLANK to keep DRY-RUN mode (emails are written to server/outbox/ only).
# Only turn this on once you have consent to contact your recipients.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Safety cap: max emails a single send request may dispatch.
MAX_EMAILS_PER_BATCH=25
